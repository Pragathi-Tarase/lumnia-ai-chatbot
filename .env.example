# ==========================================
# LUMNIA AI PLATFORM - ENVIRONMENT VARIABLES
# ==========================================

# 1. Gemini AI API Key (Required for Python Flask backend on Render)
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# 2. Python Flask Backend Configuration (Render)
PORT=5000
FLASK_ENV=production
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://localhost:3000

# 3. Frontend Configuration (Vercel)
# Set to your deployed Render backend URL in production.
# Leave empty during local development to use Vite dev proxy.
VITE_API_URL=https://your-backend-app.onrender.com

# 4. Firebase Web Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
