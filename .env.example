# ==========================================
# LUMNIA AI PLATFORM - ENVIRONMENT VARIABLES
# ==========================================

# 1. Gemini AI API Key (Required for Python Flask backend)
# Obtain key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (Optional, defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# 2. Python Flask Backend Configuration
PORT=5000
FLASK_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 3. Firebase Web Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
