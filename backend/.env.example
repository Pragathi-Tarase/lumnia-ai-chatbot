# Gemini AI API Key (Get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Variant (Optional, defaults to gemini-3.6-flash)
GEMINI_MODEL=gemini-3.6-flash

# Flask Backend Configuration (Render)
PORT=5000
FLASK_ENV=production
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://localhost:3000
